{
  "name": "xytrion-market",
  "version": "2.0.0",
  "private": true,
  "description": "Xytrion Markets static frontend with secure Node.js, MongoDB and Telegram services",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test --test-concurrency=1",
    "lint": "eslint .",
    "check": "node scripts/check-project.js",
    "doctor": "node scripts/doctor.js",
    "build": "npm run lint && npm test && npm run check"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "connect-mongo": "^5.1.0",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "mongoose": "^8.18.1",
    "multer": "^2.0.2",
    "nodemailer": "^10.0.14"
  },
  "devDependencies": {
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "mongodb-memory-server": "^10.2.1",
    "supertest": "^7.1.4"
  }
}
